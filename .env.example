# ==============================================================================
# EMIVO ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this file to .env and fill in the actual values.
# DO NOT commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SYSTEM & FASTAPI
# ------------------------------------------------------------------------------
ENV_NAME=local                  # local, preview, staging, prod
PORT=8000
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Use the connection pooling DSN (port 6543) for API, direct DSN for migrations.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/emivo_db

# ------------------------------------------------------------------------------
# REDIS (Sessions, Rate Limiting, Outbox Streams, Caching)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a secure 32+ char random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_replace_me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ------------------------------------------------------------------------------
# MEDIA STORAGE (Cloudflare R2)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=emivo-media-local
R2_PUBLIC_URL=https://media.example.com

# ------------------------------------------------------------------------------
# AI PROVIDERS (AI Gateway)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# ------------------------------------------------------------------------------
# PAYMENTS (Cashfree)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
CASHFREE_ENVIRONMENT=sandbox

# ------------------------------------------------------------------------------
# NOTIFICATIONS (Email)
# ------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key

# ------------------------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# V0.2 COMMERCE
# ------------------------------------------------------------------------------
# Canonical store tenant (printed by scripts/seed_store.py)
STORE_BUSINESS_ID=
# Payment provider: cashfree | mock (mock refused in prod)
PAYMENT_PROVIDER=mock
# Transactional email. Provider: resend (default) | smtp (Lark Mail).
# Sender aliases are routed in code (modules/notifications/aliases.py):
#   no-reply@ transactional, support@ desk replies, contact@ form inbox,
#   admin@ staff alerts, hello@ marketing. aman@ is never a system sender.
EMAIL_FROM=ELEKTRIX <no-reply@elektrix.in>
# EMAIL_PROVIDER=smtp
# EMAIL_SMTP_HOST=smtp.larksuite.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SSL=true
# EMAIL_SMTP_USER=aman@elektrix.in
# EMAIL_SMTP_PASSWORD=   # Lark authorization code — .env ONLY, never git
# Storefront public URL (links in emails)
STOREFRONT_URL=https://elektrix.in
# Public URL for the storefront + admin builds (NEXT_PUBLIC_API_URL build arg)
NEXT_PUBLIC_API_URL=https://api.elektrix.in/api/v1

# SMS for OTP login: "console" (logs codes, refuses in prod) or "msg91".
# For msg91 set MSG91_AUTH_KEY and a DLT-approved OTP template whose
# variable is #OTP#.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=ELEKTIX

# AI chatbot model fallback chain (tried in order on 429/quota/unavailable)
GEMINI_CHAT_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest
