# ==============================================================================
# EMIVO ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this file to .env and fill in the actual values.
# DO NOT commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SYSTEM & FASTAPI
# ------------------------------------------------------------------------------
ENV_NAME=local                  # local, preview, staging, prod
PORT=8000
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Use the connection pooling DSN (port 6543) for API, direct DSN for migrations.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/emivo_db

# ------------------------------------------------------------------------------
# REDIS (Sessions, Rate Limiting, Outbox Streams, Caching)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a secure 32+ char random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_replace_me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ------------------------------------------------------------------------------
# MEDIA STORAGE (Cloudflare R2)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=emivo-media-local
R2_PUBLIC_URL=https://media.example.com

# ------------------------------------------------------------------------------
# AI PROVIDERS (AI Gateway)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# ------------------------------------------------------------------------------
# PAYMENTS (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_yourkey
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# ------------------------------------------------------------------------------
# NOTIFICATIONS (Email)
# ------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key

# ------------------------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# V0.2 COMMERCE
# ------------------------------------------------------------------------------
# Canonical store tenant (printed by scripts/seed_store.py)
STORE_BUSINESS_ID=
# Payment provider: razorpay | mock (mock refused in prod)
PAYMENT_PROVIDER=mock
# Transactional email sender (must be verified in Resend)
EMAIL_FROM=ELEKTRIX <onboarding@resend.dev>
# Storefront public URL (links in emails)
STOREFRONT_URL=https://elektrix.in
# Public URL for the storefront + admin builds (NEXT_PUBLIC_API_URL build arg)
NEXT_PUBLIC_API_URL=https://api.elektrix.in/api/v1
