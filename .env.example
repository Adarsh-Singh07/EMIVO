# ==============================================================================
# ELEKTRIX ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this file to .env and fill in real values. NEVER commit .env.
# The same code runs everywhere — only the VALUES below change per environment
# (local / Azure staging VPS / Oracle production VPS).
# ==============================================================================

# ------------------------------------------------------------------------------
# COMPOSE / INFRASTRUCTURE
# ------------------------------------------------------------------------------
# MUST be "elektrix": infra/nginx/nginx.conf load-balances across the container
# names elektrix-api-1 / elektrix-api-2, which derive from the compose project
# name. Keep this regardless of the directory you clone into (e.g. /opt/elektrix).
COMPOSE_PROJECT_NAME=elektrix

# ------------------------------------------------------------------------------
# SYSTEM & FASTAPI
# ------------------------------------------------------------------------------
# local | pytest | test | staging | prod  (prod refuses PAYMENT_PROVIDER=mock)
ENV_NAME=local
PORT=8000
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API from a browser.
# Local:   http://localhost:3000,http://localhost:3001
# Azure:   http://<VM-IP>,https://elektrix.in,https://www.elektrix.in,https://admin.elektrix.in
# Oracle:  https://elektrix.in,https://www.elektrix.in,https://admin.elektrix.in
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# DATABASE (Supabase PostgreSQL, or the local compose `db` for development)
# ------------------------------------------------------------------------------
# Local dev (docker compose up db):  postgresql+asyncpg://postgres:password@db:5432/emivo
#   (from the host machine use 127.0.0.1:5432; inside compose use host `db`)
# Supabase: use the POOLER DSN (port 6543) for the API; a direct DSN (port 5432)
#   works too but pooler survives ephemeral connections better.
#   e.g. postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/emivo

# Sync DSN (postgresql://…) used ONLY by deploy/backup/RLS scripts
# (infra/scripts/deploy_vps.sh, scripts/apply_all_rls.py). Same credentials as
# DATABASE_URL with the +asyncpg part removed.
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/emivo

# ------------------------------------------------------------------------------
# REDIS (sessions, rate limiting, outbox queue, webhook dedup)
# ------------------------------------------------------------------------------
# Local dev outside compose: redis://localhost:6379/0 — inside compose the
# containers get redis://redis:6379 automatically from the compose files.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32   (min 16 chars; use 32+ in prod)
JWT_SECRET=replace_me_with_a_long_random_string_min_16_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ------------------------------------------------------------------------------
# PUBLIC URLS (the ONLY thing that really differs between environments)
# ------------------------------------------------------------------------------
# Storefront public URL — used for links in emails and Easebuzz post-payment
# redirects (surl/furl 303 target is {STOREFRONT_URL}/pay/<order>).
# Local: http://localhost:3000   Azure: http://<VM-IP> (or the temp domain)
STOREFRONT_URL=http://localhost:3000

# Public base URL of THIS API as reachable from the browser/gateway. Used to
# build the Easebuzz surl/furl callback: {API_PUBLIC_URL}/api/v1/payments/easebuzz/return
# Local: http://localhost:8000    Azure: http://<VM-IP> (or https://api.<temp-domain>)
API_PUBLIC_URL=http://localhost:8000

# Build-time API base for the storefront/admin Next.js images (NEXT_PUBLIC_*
# values are INLINED AT DOCKER BUILD TIME — changing them requires a rebuild).
# Local: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Canonical site URLs for SEO metadata / sitemap / JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
# Admin app's own URL (used in its branding config).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# PAYMENTS (Easebuzz — the active gateway)
# ------------------------------------------------------------------------------
# easebuzz | cashfree | mock   (mock refused when ENV_NAME=prod)
PAYMENT_PROVIDER=easebuzz
# From the Easebuzz dashboard (Settings → API Keys). Sandbox/test credentials
# for staging; live keys only on the production VPS.
EASEBUZZ_MERCHANT_KEY=your_easebuzz_merchant_key
# Server-side ONLY. Never sent to the frontend, never logged, never committed.
EASEBUZZ_SALT=your_easebuzz_salt
# "test" → https://testpay.easebuzz.in (sandbox)
# "production" → https://pay.easebuzz.in (live). NOTE: the live value is
# literally "production" — setting "prod" silently stays on the test gateway.
EASEBUZZ_ENVIRONMENT=test
# Post-payment redirect inside the embedded checkout frame is
# {STOREFRONT_URL}/pay/<order>; the callback endpoints the Easebuzz dashboard
# should point at are:
#   surl/furl: {API_PUBLIC_URL}/api/v1/payments/easebuzz/return
#   webhook:   {API_PUBLIC_URL}/api/v1/payments/webhook/easebuzz

# --- Legacy/alternative provider (kept for reference; not active) ---
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# MEDIA STORAGE (Cloudflare R2)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=elektrix-media
# Optional explicit endpoint; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Public CDN base for media URLs (e.g. https://media.elektrix.in)
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# NOTIFICATIONS (Email)
# ------------------------------------------------------------------------------
# resend (default) | smtp (Lark Mail / any SMTP server)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=ELEKTRIX <no-reply@elektrix.in>
# --- SMTP (used when EMAIL_PROVIDER=smtp) ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SSL=true
# --- Inbound email -> support tickets (worker IMAP poller; off by default) ---
EMAIL_IMAP_ENABLED=false
EMAIL_IMAP_HOST=imap.larksuite.com
EMAIL_IMAP_PORT=993
# Comma-separated inbox aliases the poller watches (uses EMAIL_SMTP_USER/PASSWORD)
EMAIL_IMAP_MONITORED=support@elektrix.in

# ------------------------------------------------------------------------------
# SMS / WHATSAPP
# ------------------------------------------------------------------------------
# "console" logs OTP codes (refuses in prod) | "msg91" sends real SMS.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=ELEKTRIX
# WhatsApp order updates (needs approved WABA template names):
# WHATSAPP_ENABLED=true
# MSG91_WHATSAPP_FROM=91xxxxxxxxxx
# MSG91_WHATSAPP_TEMPLATES="order.shipped=tpl_ship,order.delivered=tpl_del"
WHATSAPP_ENABLED=false
MSG91_WHATSAPP_FROM=
MSG91_WHATSAPP_TEMPLATES=

# ------------------------------------------------------------------------------
# AI (support chatbot + product copy) — optional
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
# Comma-separated fallback chain tried in order on 429/quota errors.
GEMINI_CHAT_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest
CHATBOT_DAILY_MESSAGE_LIMIT=30
# Optional alternative AI gateway provider.
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# SHIPPING / COD DEFAULTS (paise; admin can override at runtime)
# ------------------------------------------------------------------------------
FREE_SHIPPING_THRESHOLD=99900
FLAT_SHIPPING_PAISE=9900
COD_ENABLED=true
COD_FEE_PAISE=5000
COD_MAX_ORDER_PAISE=50000000

# ------------------------------------------------------------------------------
# LOGISTICS (Delhivery — optional courier integration)
# ------------------------------------------------------------------------------
DELHIVERY_API_KEY=
DELHIVERY_ORIGIN_PINCODE=
DELHIVERY_ENVIRONMENT=prod

# ------------------------------------------------------------------------------
# STORE SEEDING / OPERATIONS
# ------------------------------------------------------------------------------
# Canonical store tenant UUID. If empty, resolved by business name "ELEKTRIX"
# (scripts/seed_store.py prints it after seeding).
STORE_BUSINESS_ID=
ADMIN_EMAIL=admin@elektrix.in
ADMIN_INITIAL_PASSWORD=

# ------------------------------------------------------------------------------
# STOREFRONT ANALYTICS (all optional; leave blank to load no third-party JS)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=1234567890
